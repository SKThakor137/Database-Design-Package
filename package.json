{
  "name": "schemagraph-core",
  "version": "1.0.0",
  "description": "Zero-dependency pure Node.js CLI & library to parse schemas (SQL, Prisma, Mongoose, Sequelize, TypeORM, GraphQL, TS Types) and generate responsive SVG ERDs, interactive HTML viewers, Mermaid markdown, DBML, DOT, and JSON schema maps.",
  "main": "src/index.js",
  "bin": {
    "schemagraph": "bin/schemagraph.js",
    "schemagraph-core": "bin/schemagraph.js",
    "pure-erd": "bin/schemagraph.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/schemagraph.js",
    "demo": "node bin/schemagraph.js ./examples --format=all --output=./demo-output",
    "test": "node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SKThakor137/Database-Design-Package.git"
  },
  "keywords": [
    "erd",
    "database-diagram",
    "schema-visualizer",
    "database-design",
    "sql",
    "prisma",
    "mongoose",
    "sequelize",
    "typeorm",
    "graphql",
    "typescript-types",
    "zod",
    "svg",
    "mermaid",
    "dbml",
    "zero-dependency",
    "interactive-erd"
  ],
