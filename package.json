{
  "name": "schemagraph",
  "version": "1.4.1",
  "description": "Zero-dependency pure Node.js CLI & library to parse schemas across any framework (Laravel, Django, Rails, Go, Spring JPA, Prisma, Mongoose, Sequelize, TypeORM, GraphQL, SQL) and generate responsive SVG ERDs, interactive HTML viewers, Mermaid markdown, DBML, DOT, AI context prompts (ChatGPT/Gemini/Claude), and JSON schema maps.",
  "main": "src/index.js",
  "bin": {
    "schemagraph": "bin/schemagraph.js",
    "pure-erd": "bin/schemagraph.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "llms.txt",
    "llms-full.txt"
  ],
  "scripts": {
    "start": "node bin/schemagraph.js",
    "demo": "node bin/schemagraph.js ./examples --format=all --output=./demo-output",
    "test": "node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
